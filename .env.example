# =============================================================================
# TradeLog 环境变量配置
# 复制此文件为 .env 并修改对应值
# =============================================================================

# 数据库配置
DB_ROOT_PASSWORD=tradelog_root_password_change_this
DB_USER=tradeloguser
DB_PASSWORD=tradelog_password_change_this

# JWT 密钥（生产环境请使用随机字符串：openssl rand -base64 32）
JWT_SECRET=change_this_to_a_random_long_string

# 邮件配置 (163 SMTP)
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_email@163.com
SMTP_PASS=your_163_authorization_code
SMTP_TO=receiver@example.com
